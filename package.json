{
  "name": "sharecanvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "基于画布的共享创作涂鸦：2D 涂鸦 + 3D 草稿 + 好友实时协作",
  "scripts": {
    "dev": "vite",
    "dev:all": "node dev.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "server": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "three": "^0.178.0",
    "three-stdlib": "^2.36.1",
    "ws": "^8.18.0",
    "y-indexeddb": "^9.0.12",
    "y-redis": "^1.0.3",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.32",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
