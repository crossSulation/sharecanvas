PORT=8787
# 绑定地址：默认 0.0.0.0（支持局域网共享）；仅本机访问可设 HOST=127.0.0.1 加固
# HOST=0.0.0.0
E2E_PORT=8791
DATA_DIR=data/rooms
# 本机数据服务地址（Tauri WebView 中相对路径 fetch 失效时使用）
LOCAL_DATA_URL=http://192.168.19.118:5173
# 是否在头部显示“训练样本收集”入口（1/true 显示，0/false 隐藏）
ENABLE_TRAIN=1
# 可选：Redis 连接 URL，用于多服务器水平扩展同步
# REDIS_URL=redis://localhost:6379
